# Environment for the qwen38-flash systemd unit. Same variables as scripts/serve.sh
# (see its header for the full list). Copy to systemd/qwen38-flash.env (untracked, so
# host paths stay out of git), edit, then: sudo systemctl restart qwen38-flash
PORT=8000
# vLLM v0.32.0 base (docker build -t qwen38-flash-dgx:v0.32 .)
IMAGE=qwen38-flash-dgx:v0.32
# Hub dirs to serve the weights from, first usable wins (e.g. an NFS share, then the local
# cache). Absolute paths: systemd does not expand variables here. Unset = $HF_CACHE/hub.
#HF_HUB_DIRS=/mnt/nfs-share/cache/huggingface_hub:/home/USER/.cache/huggingface/hub
MODE=hybrid
YARN=1
CTX=500000
# DFlash2 draft instead of the MTP head (as profiles/dflash.env). One-time download into the
# local cache: scripts/download-draft.sh. MTP/DRAFT_VOCAB are MTP-head settings; 0 keeps the
# serve line truthful.
DRAFT_MODEL=incoai/Qwen3.8-Flash-Next-DFlash2
MTP=0
DRAFT_VOCAB=0
# all 20 cores, not serve.sh's default 5-9,15-19: pinned, prefill 8k/32k was 2,329/2,746 tok/s,
# unpinned 2,805/2,907 (the PLE mmap gather runs 32 CPU threads); decode unchanged
CPUSET=
# compiled graphs are per base image
COMPILE_CACHE=qwen38v032
# journald can't render tqdm's \r-redrawn load bar (shows "[108B blob data]" instead)
EXTRA=--no-use-tqdm-on-load
