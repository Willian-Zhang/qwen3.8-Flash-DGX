# Environment for the qwen38-flash systemd unit. Same variables as scripts/serve.sh
# (see its header for the full list). Edit, then: sudo systemctl restart qwen38-flash
PORT=8000
MODE=hybrid
YARN=1
CTX=500000
MTP=3
PREWARM=1
# journald can't render tqdm's \r-redrawn load bar (shows "[108B blob data]" instead)
EXTRA=--no-use-tqdm-on-load
